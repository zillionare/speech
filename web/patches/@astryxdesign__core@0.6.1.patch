+// 旧 WebKit 仅补定位，菜单样式、焦点和键盘交互继续由 Astryx 管理。
+export function positionLegacyLayer(
+  layer: HTMLElement,
+  trigger: HTMLElement,
+  {placement = 'above', alignment = 'center', offset, positioning}: ContextRenderProps,
+): (() => void) | undefined {
+  if (positioning === 'custom') return;
+  const originalStyle = layer.getAttribute('style');
+  const originalOpacity = layer.style.opacity;
+  const originalAnimation = layer.style.animation;
+  const selector = layer.querySelector('.astryx-selector-popup');
+  const rtl = getComputedStyle(trigger).direction === 'rtl';
+  const side = {above: 'top', below: 'bottom', start: rtl ? 'right' : 'left', end: rtl ? 'left' : 'right'}[placement];
+  const floatingPlacement = `${side}${alignment === 'center' ? '' : `-${alignment}`}` as Placement;
+  // 清除原生居中和残留锚点约束；首次定位前透明显示，既避免闪动，也允许 WebKit 把焦点移入菜单。
+  Object.assign(layer.style, {
+    position: 'fixed', inset: 'auto', top: '0px', left: '0px',
+    positionAnchor: 'auto', positionArea: 'none', positionTryFallbacks: 'none',
+    margin: typeof offset === 'number' ? `${offset}px` : offset ?? '0px',
+    width: selector ? `${trigger.getBoundingClientRect().width}px` : 'max-content',
+    opacity: '0', animation: 'none',
+  });
+  const gap = parseFloat(getComputedStyle(layer).marginTop) || 0;
+  layer.style.margin = '0';
+  let revision = 0;
+  let disposed = false;
+  const cleanup = autoUpdate(trigger, layer, () => {
+    const current = ++revision;
+    const isCurrent = () => !disposed && current === revision;
+    void computePosition(trigger, layer, {
+      strategy: 'fixed',
+      placement: floatingPlacement,
+      middleware: [
+        floatingOffset(gap), flip(), shift(),
+        size({apply({availableWidth, availableHeight, rects}) {
+          if (!isCurrent()) return;
+          Object.assign(layer.style, {
+            maxWidth: `${Math.max(0, availableWidth)}px`,
+            maxHeight: `${Math.max(0, availableHeight)}px`,
+          });
+          if (selector) layer.style.width = `${Math.min(rects.reference.width, Math.max(0, availableWidth))}px`;
+          // 超大菜单允许滚动，常规菜单保留阴影。
